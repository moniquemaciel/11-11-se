# Copie este arquivo para ".env" e preencha com suas credenciais reais do Mercado Pago
# (Painel do Mercado Pago → Suas integrações → Credenciais de produção)

MERCADO_PAGO_ACCESS_TOKEN=
PORT=3000

# URL pública do site (usada como back_url das assinaturas de cartão)
SITE_URL=https://loja.11e11-se.com.br

# Chave simples para proteger o painel de assinantes Pix/Boleto vencendo
# (GET /api/assinaturas/vencendo?admin_key=SUA_CHAVE). Invente uma string
# longa e aleatória — sem essa variável, o painel fica sempre bloqueado.
ADMIN_KEY=
